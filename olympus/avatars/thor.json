{
  "id": "thor",
  "displayName": "Thor",
  "role": "Bounded implementation and verification lane",
  "authority": "implementation",
  "avatar": {
    "renderer": "airi",
    "assetRef": "${OLYMPUS_THOR_AVATAR_ASSET}",
    "stateModel": "builder"
  },
  "voice": {
    "provider": "local-adapter",
    "voiceRef": "${OLYMPUS_THOR_VOICE}",
    "language": "en-US"
  },
  "capabilities": ["conversation", "implementation-planning", "code-review", "bounded-build-request", "status-read"],
  "adapter": {
    "transport": "loopback-http",
    "bind": "127.0.0.1",
    "profileRef": "${OLYMPUS_THOR_PROFILE}",
    "requestAllowlist": ["health", "chat", "avatar-state", "handoff", "status-read"]
  },
  "security": {
    "allowShell": false,
    "allowFilesystem": false,
    "allowBrowser": false,
    "allowHardware": false,
    "requiresHumanApproval": true,
    "maxRequestBytes": 262144,
    "timeoutMs": 60000
  }
}
